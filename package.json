{
  "name": "colamd",
  "version": "2.7.7",
  "description": "A free, elegant Markdown editor for macOS, Windows and Linux. Simple by design, always in sync with the file on disk.",
  "main": "dist/main/index.js",
  "author": {
    "name": "marswave.ai",
    "email": "hello@marswave.ai"
  },
  "license": "MIT",
  "homepage": "https://github.com/marswaveai/colamd",
  "repository": {
    "type": "git",
    "url": "https://github.com/marswaveai/colamd.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "check:theme-colors": "node scripts/check-theme-colors.mjs",
    "verify:markdown": "node scripts/verify-markdown.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:features": "node scripts/verify-features.mjs",
    "verify:scroll-render": "node scripts/verify-scroll-render.mjs",
    "verify:image-export": "node scripts/verify-image-export.mjs",
    "verify:export-pdf": "node scripts/verify-export-pdf.mjs",
    "verify:themes": "node scripts/verify-themes.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:build:android": "node scripts/cap-android.mjs debug",
    "cap:build:android:release": "node scripts/cap-android.mjs release",
    "dist:android": "node scripts/cap-android.mjs release",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@capawesome/capacitor-file-picker": "^6.2.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@lezer/markdown": "^1.7.2",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "katex": "^0.16.47",
    "pele": "^1.6.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/katex": "^0.16.8",
    "electron": "^44.3.0",
    "electron-builder": "^26.16.1",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
